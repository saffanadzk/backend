# Midtrans Configuration (Sandbox)
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_SERVER_KEY
MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_CLIENT_KEY
MIDTRANS_IS_PRODUCTION=false

# Internal API Key (untuk melindungi endpoint POST /api/payments)
INTERNAL_API_KEY=prelove-internal-secret-key-change-me

# Demo / Mock Routes (true untuk mengaktifkan mock routes, default false)
ENABLE_DEMO=false

# Database Connection (SQLite by default, atau PostgreSQL/MySQL dengan Prisma)
# PostgreSQL contoh: postgresql://postgres:password@localhost:5432/prelove_payment?schema=public
DATABASE_URL="file:./dev.db"

# Server Port
PORT=3000
